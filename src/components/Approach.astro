---
import { bodyMap } from '../data/master';
---

<section id="approach" class="approach">
  <div class="wrap">
    <div class="intro">
      <header class="section-head" data-reveal>
        <span class="section-eyebrow">Мой подход</span>
        <h2>
          Целостный подход: тело, психика и&nbsp;<em>ограничивающие убеждения</em>.
        </h2>
      </header>
      <div class="text" data-reveal data-reveal-delay="120">
        <p class="lead">
          Организм человека это мудрая система, поэтому задачу эффективнее
          решать комплексно.
        </p>
        <p>
          Полученный опыт формирует негативные установки. Они приводят к&nbsp;тому,
          что мы блокируем эмоции, а&nbsp;эмоции формируют блоки и&nbsp;зажимы.
          Зажатость тела приводит к&nbsp;сбоям и&nbsp;заболеваниям. Работая
          с&nbsp;телом, мы освобождаемся от&nbsp;груза непрожитых эмоций и&nbsp;исцеляем
          психологические травмы, которые привели к&nbsp;этим убеждениям.
        </p>
      </div>
    </div>

    <div class="map-head" data-reveal>
      <h3>Карта телесных зажимов</h3>
      <p>Нажмите на&nbsp;зону и&nbsp;посмотрите, что за&nbsp;ней стоит на&nbsp;трёх уровнях.</p>
    </div>

    <div class="map">
      {bodyMap.map((z, i) => (
        <details class="zone" data-reveal data-reveal-delay={Math.min(i * 40, 320)}>
          <summary>
            <span class="zn">{String(i + 1).padStart(2, '0')}</span>
            <span class="zt">{z.zone}</span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <dl>
            <div><dt>Тело</dt><dd>{z.body}</dd></div>
            <div><dt>Мышление</dt><dd>{z.mind}</dd></div>
            <div><dt>Эмоции</dt><dd>{z.emotions}</dd></div>
          </dl>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
  }
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
    margin-bottom: 64px;
  }
  .intro .section-head {
    margin-bottom: 0;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .text .lead {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.4;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .text p {
    color: var(--ink-muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .map-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 32px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--line-strong);
  }
  .map-head h3 {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .map-head p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 15px;
  }

  .map {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    align-items: start;
  }
  .zone {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 14px;
    transition: border-color 0.18s ease;
  }
  .zone[open] {
    border-color: var(--accent-line);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .zn {
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .zt {
    font-family: var(--font-serif);
    font-size: 19px;
    color: var(--ink);
    flex: 1;
  }
  .plus {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s ease;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .zone[open] .plus::after {
    transform: rotate(0deg);
  }
  dl {
    margin: 0;
    padding: 0 20px 20px;
    display: grid;
    gap: 12px;
  }
  dt {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  @media (max-width: 1024px) {
    .map {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      margin-bottom: 48px;
    }
  }
  @media (max-width: 560px) {
    .map {
      grid-template-columns: 1fr;
    }
  }
</style>
