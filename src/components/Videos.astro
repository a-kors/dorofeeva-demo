---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { master, videos } from '../data/master';

const thumbs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/video/*.jpg', { eager: true });
const thumbOf = (id: string) => thumbs[`/src/assets/video/${id}.jpg`].default;
---

<section id="video" class="vd">
  <div class="wrap">
    <header class="head" data-reveal>
      <div>
        <span class="section-eyebrow">Видео</span>
        <h2>Рассказываю о&nbsp;телесной терапии на&nbsp;YouTube.</h2>
      </div>
      <a class="btn btn-ghost" href={master.youtube} target="_blank" rel="noopener">
        Все видео на&nbsp;канале →
      </a>
    </header>

    <div class="grid">
      {videos.map((v, i) => (
        <a
          class="vc"
          href={`https://www.youtube.com/watch?v=${v.id}`}
          target="_blank"
          rel="noopener"
          data-reveal
          data-reveal-delay={Math.min(i * 90, 300)}
        >
          <span class="poster">
            <Image
              src={thumbOf(v.id)}
              alt=""
              widths={[400, 640]}
              sizes="(max-width: 600px) 90vw, 300px"
              format="webp"
              quality={70}
              loading="lazy"
            />
            <span class="play" aria-hidden="true">▶</span>
          </span>
          <span class="title">{v.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .vd {
    background: var(--bg);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .head h2 {
    margin: 0;
    max-width: 640px;
  }
  .head .btn {
    padding: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .vc {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }
  .poster {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--ink);
  }
  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .vc:hover .poster :global(img) {
    transform: scale(1.03);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    padding-left: 3px;
    box-shadow: 0 14px 28px -10px rgba(0, 0, 0, 0.45);
  }
  .title {
    font-size: 15px;
    line-height: 1.45;
    transition: color 0.18s ease;
  }
  .vc:hover .title {
    color: var(--accent);
  }
  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
